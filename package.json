{
  "name": "master-dashboard",
  "version": "1.0.0",
  "description": "private project",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "main": "index.js",
  "scripts": {
    "dev": "concurrently -k -n api,web,coding -c blue,magenta,cyan \"npm run dev -w api\" \"npm run dev -w web\" \"npm run dev -w coding\"",
    "test": "echo \"Error: no test specified\" && exit 1",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev && prisma generate",
    "db:deploy": "prisma migrate deploy && prisma generate",
    "stop": "lsof -ti tcp:4000,5173,5174,5175,5176 | xargs kill -9 2>/dev/null; echo 'stopped dev servers on 4000, 5173-5176'"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hardytran90/Master-Dashboard.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/hardytran90/Master-Dashboard/issues"
  },
  "homepage": "https://github.com/hardytran90/Master-Dashboard#readme",
  "devDependencies": {
    "@types/node": "^26.2.0",
    "concurrently": "^9.2.5",
    "dotenv": "^17.4.2",
    "prisma": "^7.9.1"
  }
}
